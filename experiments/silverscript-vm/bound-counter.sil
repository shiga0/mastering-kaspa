pragma silverscript ^0.1.0;

contract BoundCounter(int initialCount) {
    int count = initialCount;

    entry step() {
        byte[32] lineage = OpInputCovenantId(this.activeInputIndex);
        require(OpCovInputCount(lineage) == 1);
        require(OpCovOutputCount(lineage) == 1);
        require(OpCovOutputIdx(lineage, 0) == 0);
        require(tx.outputs.length == 1);
        require(tx.outputs[0].value == tx.inputs[this.activeInputIndex].value);
        validateOutputState(0, State { count: count + 1 });
    }
}
